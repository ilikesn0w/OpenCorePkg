[Defines]
  INF_VERSION                    = 0x0001001B
  BASE_NAME                      = OcAppleDeviceControlLib
  FILE_GUID                      = B00415A2-05A8-435B-BC44-C76D65C14C7A
  MODULE_TYPE                    = BASE
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = OcAppleDeviceControlLib|PEIM DXE_DRIVER DXE_RUNTIME_DRIVER UEFI_DRIVER UEFI_APPLICATION DXE_SMM_DRIVER

#
# The following information is for reference only and not required by the build tools.
